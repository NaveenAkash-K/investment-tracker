{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://personal-investment-tracker.local/contracts/analyzer-tracker/2026-07-28.v1",
  "title": "Analyzer to Investment Tracker contract",
  "contract_version": "2026-07-28.v1",
  "legacy_version": "legacy-unversioned",
  "payloads": {
    "market_run": {
      "type": "object",
      "required": ["contract_version", "run_id", "run_type", "as_of", "status", "model_version", "market_scores", "sip_recommendations", "global_recommendations", "alerts"],
      "properties": {
        "contract_version": {"const": "2026-07-28.v1"},
        "run_id": {"type": "string", "format": "uuid"},
        "run_type": {"enum": ["daily", "weekly", "monthly"]},
        "as_of": {"type": "string", "format": "date-time"},
        "status": {"enum": ["successful", "partial", "failed"]},
        "model_version": {"type": "string", "minLength": 1},
        "market_scores": {"type": "array"},
        "sip_recommendations": {"type": "array"},
        "global_recommendations": {"type": "array"},
        "alerts": {"type": "array"}
      },
      "additionalProperties": true
    },
    "swing_scan": {
      "type": "object",
      "required": ["contract_version", "scan_id", "as_of", "status", "model_version", "market_regime", "session_state", "session_matches_expected", "candidates"],
      "properties": {
        "contract_version": {"const": "2026-07-28.v1"},
        "scan_id": {"type": "string", "format": "uuid"},
        "as_of": {"type": "string", "format": "date-time"},
        "status": {"enum": ["successful", "partial", "failed", "no_session"]},
        "model_version": {"type": "string", "minLength": 1},
        "market_regime": {"enum": ["GREEN", "AMBER", "RED", "UNKNOWN"]},
        "session_state": {"enum": ["completed", "no_session", "before_close", "unknown"]},
        "session_matches_expected": {"type": "boolean"},
        "candidates": {"type": "array"}
      },
      "additionalProperties": true
    },
    "swing_monitor": {
      "type": "object",
      "required": ["contract_version", "monitor_id", "as_of", "status", "model_version", "candidate_updates", "position_updates", "notifications"],
      "properties": {
        "contract_version": {"const": "2026-07-28.v1"},
        "monitor_id": {"type": "string", "format": "uuid"},
        "as_of": {"type": "string", "format": "date-time"},
        "status": {"enum": ["successful", "partial", "failed", "disabled"]},
        "model_version": {"type": "string", "minLength": 1},
        "candidate_updates": {"type": "array"},
        "position_updates": {"type": "array"},
        "notifications": {"type": "array"}
      },
      "additionalProperties": true
    },
    "news_run": {
      "type": "object",
      "required": ["contract_version", "run_id", "as_of", "status", "model_version", "sources", "articles", "events", "alerts"],
      "properties": {
        "contract_version": {"const": "2026-07-28.v1"},
        "run_id": {"type": "string", "format": "uuid"},
        "as_of": {"type": "string", "format": "date-time"},
        "status": {"enum": ["successful", "partial", "failed"]},
        "model_version": {"type": "string", "minLength": 1},
        "sources": {"type": "array"},
        "articles": {"type": "array"},
        "events": {"type": "array"},
        "alerts": {"type": "array"}
      },
      "additionalProperties": true
    }
  }
}
